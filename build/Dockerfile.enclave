# check=skip=SecretsUsedInArgOrEnv
#
# The check above is skipped for the build argument CREDENTIAL_ENCLAVE_RELEASE: it is the
# release name, and its name alone makes the build check take it for a secret.
#
# The enclave image (enclave.md 11.1, step 4): the node program as the only file of an image
# built `FROM scratch`. `builder/enclave-build.sh` builds this file and turns the image into
# the enclave image file (EIF) whose measurements identify a release. Do not build it by hand
# for a release: the measurements depend on the arguments and on the exporter options that
# the procedure passes.
#
# This file is the part of the build a commit decides: how the node program is compiled. It is
# built by a BuildKit daemon that has no network, so nothing here reaches outside the build
# context. The build context is three things:
#
#   - the files of the commit;
#   - `toolchain`: the image `build/inputs.json` of the commit names by digest (Rust
#     toolchain, C compiler, C library headers). The procedure fetched it by that digest;
#   - `vendor`: the packages `Cargo.lock` of the commit names, which the procedure downloaded
#     from crates.io and cargo checked against the checksums of `Cargo.lock`.
#
# The measurements cover the time of the node program in the image, which is the commit time.
# Two things keep that time the same on a machine with a layer cache and on one without. The
# stage `build` sets the time of the file it built. And the procedure builds the stage `image`
# anew at every build: the copy of that stage is found in the layer cache by the bytes of the
# file, so a commit whose node program has the bytes of an earlier build would otherwise get
# the layer of that build, with the time that build gave the file.
#
# Every input of the binary is fixed:
#   - the image `toolchain`, by digest;
#   - `rust-toolchain.toml` (the same Rust version as that image) and `Cargo.lock`;
#   - the release profile of the workspace `Cargo.toml`;
#   - the working directory, the path remapping and the environment below.
# The build installs no package. The C parts of the `ring` crate need the headers of the C
# library (`musl-dev`), which the image `toolchain` contains: the version is asserted below.
FROM toolchain AS build

# The release name is compiled into the program and is part of the attestation binding. The
# procedure passes the name of the tag that started the build, or `dev`.
ARG CREDENTIAL_ENCLAVE_RELEASE=dev
# The time of the commit. The node program gets it as the time of its file, and BuildKit
# stamps the image with it.
ARG SOURCE_DATE_EPOCH=0

ENV CARGO_INCREMENTAL=0 \
    TZ=UTC \
    LC_ALL=C \
    SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    CREDENTIAL_ENCLAVE_RELEASE=${CREDENTIAL_ENCLAVE_RELEASE} \
    RUSTFLAGS="--remap-path-prefix=/build=/credential-enclave --remap-path-prefix=/usr/local/cargo=/cargo --remap-path-prefix=/usr/local/rustup=/rustup"

RUN apk info -v | grep -qx 'musl-dev-1.2.6-r2' \
    && test "$(rustc --version)" = "rustc 1.98.1 (48a229cea 2026-09-01)"

WORKDIR /build
COPY rust-toolchain.toml Cargo.toml Cargo.lock ./
COPY protocol protocol
COPY enclave enclave
COPY host host
COPY verify verify

# The packages of `Cargo.lock`, as the procedure vendored them, and the cargo configuration
# that makes them the source of every crates.io package. The commit holds no cargo
# configuration of its own (the procedure refuses a commit that does).
COPY --from=vendor / vendor
RUN mkdir .cargo \
    && printf '[source.crates-io]\nreplace-with = "vendored-sources"\n\n[source.vendored-sources]\ndirectory = "vendor"\n' >.cargo/config.toml

# The compilation. The build scripts and the procedural macros of the commit and of its
# dependencies run here, without a network.
RUN cargo build --release --locked --offline --target x86_64-unknown-linux-musl -p credential-enclave \
    && touch -d "@${SOURCE_DATE_EPOCH}" target/x86_64-unknown-linux-musl/release/credential-enclave

FROM scratch AS image
COPY --from=build /build/target/x86_64-unknown-linux-musl/release/credential-enclave /credential-enclave
ENTRYPOINT ["/credential-enclave", "--platform", "nitro"]
